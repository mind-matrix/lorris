# Optional TURN relays for players whose networks block direct WebRTC connections (common on
# mobile data). Copy to .env.local for local builds; in CI these come from repository secrets.
# Leave a relay's variables empty to not use it. Never commit real values.
#
# NOTE: whatever you put here is built into the app and visible to anyone who opens it.
# There's no backend to hide it behind; rely on relay quotas and rotate credentials if abused.

# Open Relay by Metered (free hosted TURN). Credentials are fetched at runtime from
# https://<VITE_METERED_APP>.metered.live/api/v1/turn/credentials?apiKey=<VITE_METERED_API_KEY>
VITE_METERED_APP=            # the subdomain only, e.g. "game" for game.metered.live
VITE_METERED_API_KEY=

# Our own coturn relay (all three needed).
VITE_TURN_URLS=              # comma-separated, e.g. turn:relay.example.com:3478,turns:relay.example.com:5349
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
